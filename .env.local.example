NEXT_PUBLIC_SUPABASE_APP_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_APP_KEY=your-publishable-key

# The public marketing site (website/) — used to build links sent to
# clients, e.g. the "Request a Review" WhatsApp message. Not a secret.
NEXT_PUBLIC_WEBSITE_URL=https://epc.vet

# Consult/surgery audio recording -> transcript -> AI summary. Server-side
# only (no NEXT_PUBLIC_ prefix) — never exposed to the browser.
ANTHROPIC_API_KEY=your-anthropic-api-key
ASSEMBLYAI_API_KEY=your-assemblyai-api-key

# Shared staff PIN gating the whole app except the public client portal
# (see middleware.js and lib/staffAuth.js) — one PIN for everyone on
# staff, not a real per-user login. Login attempts are rate-limited (see
# lib/loginRateLimit.js) since a short PIN is otherwise easy to brute-force.
STAFF_PINCODE=choose-a-staff-pin

# A second, extra password on top of STAFF_PINCODE for the owner/
# accountant-only /accounting section (see lib/accountingAuth.js).
ACCOUNTING_PASSWORD=choose-an-accounting-password

# Meta WhatsApp Business Cloud API — see lib/metaWhatsapp.js. The first two
# are already required for the client-app OTP login; the next two are only
# needed once you set app/api/whatsapp/webhook as the number's webhook URL
# in Meta App Dashboard > WhatsApp > Configuration, to receive/reply to
# real client conversations (see app/(admin)/messages).
META_WHATSAPP_ACCESS_TOKEN=your-permanent-system-user-token
META_WHATSAPP_PHONE_NUMBER_ID=your-registered-number-id
# A secret you choose yourself, entered in Meta's webhook setup screen too
# — confirms the GET verification handshake is really Meta.
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=choose-a-webhook-verify-token
# From Meta App Dashboard > App Settings > Basic > App Secret — verifies
# every inbound webhook POST is really from Meta (see the route's
# X-Hub-Signature-256 check) before any of it is trusted.
META_WHATSAPP_APP_SECRET=your-meta-app-secret
