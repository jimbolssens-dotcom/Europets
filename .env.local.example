NEXT_PUBLIC_SUPABASE_APP_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_APP_KEY=your-publishable-key

# The public marketing site (website/) — used to build links sent to
# clients, e.g. the "Request a Review" WhatsApp message. Not a secret.
NEXT_PUBLIC_WEBSITE_URL=https://epc.vet

# Consult/surgery audio recording -> transcript -> AI summary. Server-side
# only (no NEXT_PUBLIC_ prefix) — never exposed to the browser.
ANTHROPIC_API_KEY=your-anthropic-api-key
ASSEMBLYAI_API_KEY=your-assemblyai-api-key

# Shared staff PIN gating the whole app except the public client portal
# (see middleware.js and lib/staffAuth.js) — one PIN for everyone on
# staff, not a real per-user login. Login attempts are rate-limited (see
# lib/loginRateLimit.js) since a short PIN is otherwise easy to brute-force.
STAFF_PINCODE=choose-a-staff-pin

# A second, extra password on top of STAFF_PINCODE for the owner/
# accountant-only /accounting section (see lib/accountingAuth.js).
ACCOUNTING_PASSWORD=choose-an-accounting-password

# Meta WhatsApp Business Cloud API — see lib/metaWhatsapp.js. The first two
# are already required for the client-app OTP login; the next two are only
# needed once you set app/api/whatsapp/webhook as the number's webhook URL
# in Meta App Dashboard > WhatsApp > Configuration, to receive/reply to
# real client conversations (see app/(admin)/messages).
META_WHATSAPP_ACCESS_TOKEN=your-permanent-system-user-token
META_WHATSAPP_PHONE_NUMBER_ID=your-registered-number-id
# A secret you choose yourself, entered in Meta's webhook setup screen too
# — confirms the GET verification handshake is really Meta.
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=choose-a-webhook-verify-token
# From Meta App Dashboard > App Settings > Basic > App Secret — verifies
# every inbound webhook POST is really from Meta (see the route's
# X-Hub-Signature-256 check) before any of it is trusted.
META_WHATSAPP_APP_SECRET=your-meta-app-secret
# The WhatsApp Business Account ID (not the phone number ID above) — from
# Meta Business Settings > Accounts > WhatsApp accounts, or the App
# Dashboard's WhatsApp API Setup page. Only needed to use the "Fix
# WhatsApp subscription" button on app/(admin)/messages (see
# subscribeWhatsAppWebhook in lib/metaWhatsapp.js) — a one-time step
# Meta's dashboard doesn't otherwise prompt for.
META_WHATSAPP_WABA_ID=your-whatsapp-business-account-id

# Turns on the WhatsApp AI concierge (lib/whatsappConcierge.js) — for a
# client WhatsApp already recognizes, it drafts and sends its own replies
# to clinic FAQs and routine consult bookings, and hands everything else
# (anything medical, anything about money already paid, any other kind of
# appointment) to staff untouched. Off (no auto-replies at all, every
# message just sits in the inbox as before) unless this is exactly
# "true" — the fastest way to fully disable it if it ever needs to be,
# no redeploy required. Needs migrations/132_client_messages_ai_sender.sql
# run first.
WHATSAPP_AI_ENABLED=false

# The staff app's own public base URL (no trailing slash) — used to build
# links that are sent outside the app itself, like a consent-form template
# button (see lib/metaWhatsapp.js's submitConsentFormTemplate/
# sendConsentFormRequest) or a consent link copied to clipboard. Not the
# same as the unrelated NEXT_PUBLIC_APP_URL under website/.
APP_URL=https://your-deployed-app.vercel.app

# Automated outbound WhatsApp consent forms (see
# app/api/consent-form-requests/route.js and the "Submit consent form
# WhatsApp template" button on app/(admin)/messages) need their own
# Meta-approved template, since most recipients won't have an open 24-hour
# conversation window — unlike a plain reply, this can reach any client to
# deliberately introduce them to the clinic's WhatsApp number. Both have
# working defaults below; only set these if you want a different template
# name/language.
META_WHATSAPP_CONSENT_TEMPLATE_NAME=consent_form_ready
META_WHATSAPP_CONSENT_TEMPLATE_LANG=en_US

# Same pattern as the consent-form template above, for automated
# vaccination-due reminders (see app/api/vaccinations/send-reminder and
# the "Submit vaccination reminder WhatsApp template" button on
# app/(admin)/messages) — its Quick Reply button lets the client book an
# appointment straight through that same conversation, handled by the
# existing AI concierge (WHATSAPP_AI_ENABLED must be "true" for that part
# to actually reply). Working defaults below; only set these for a
# different template name/language.
META_WHATSAPP_VACCINATION_TEMPLATE_NAME=vaccination_reminder
META_WHATSAPP_VACCINATION_TEMPLATE_LANG=en_US

# A generic fallback template (one free-text variable) used automatically
# whenever staff types a plain WhatsApp reply to a client with no open
# 24-hour conversation window — see POST /api/clients/:id/messages and the
# "Submit first-contact WhatsApp template" button on app/(admin)/messages.
# Working defaults below; only set these for a different template
# name/language.
META_WHATSAPP_FIRST_CONTACT_TEMPLATE_NAME=clinic_message
META_WHATSAPP_FIRST_CONTACT_TEMPLATE_LANG=en_US

# Same pattern, for the Invite page's "New Patient Intake" send/resend
# buttons (see app/(admin)/intake/page.jsx and the "Submit intake-link
# WhatsApp template" button on app/(admin)/messages) — one shared template
# covers both the new-client and existing-client wording. Working defaults
# below; only set these for a different template name/language.
META_WHATSAPP_INTAKE_TEMPLATE_NAME=new_patient_intake_link
META_WHATSAPP_INTAKE_TEMPLATE_LANG=en_US

# Same pattern, for the Invite page's "Client App Link" button (see
# app/(admin)/intake/page.jsx and the "Submit client-app-link WhatsApp
# template" button on app/(admin)/messages). Working defaults below; only
# set these for a different template name/language.
META_WHATSAPP_CLIENT_APP_TEMPLATE_NAME=client_app_link
META_WHATSAPP_CLIENT_APP_TEMPLATE_LANG=en_US

# Post-discharge "how's recovery going?" WhatsApp check-ins (see
# lib/dischargeFollowups.js and app/(admin)/follow-ups) — review-first by
# default: a staff member reads/edits the drafted message and clicks Send.
# Set DISCHARGE_FOLLOWUP_AUTOSEND to "true" once this is trusted enough to
# send itself the moment it's due, with no review step — the eligibility
# check (not deceased, not rehomed, not readmitted) and the send itself
# stay exactly the same either way. DISCHARGE_FOLLOWUP_DELAY_HOURS (default
# 48) is how long after discharge a follow-up becomes due.
DISCHARGE_FOLLOWUP_AUTOSEND=false
DISCHARGE_FOLLOWUP_DELAY_HOURS=48

# Same pattern as the templates above, for the discharge follow-ups' own
# branded check-in message (see the "Submit discharge follow-up WhatsApp
# template" button on app/(admin)/messages and
# lib/dischargeFollowups.js's sendDischargeFollowup) — kept separate from
# the generic first-contact template so a follow-up reads as its own thing.
# Working defaults below; only set these for a different template
# name/language.
META_WHATSAPP_DISCHARGE_FOLLOWUP_TEMPLATE_NAME=discharge_followup_checkin
META_WHATSAPP_DISCHARGE_FOLLOWUP_TEMPLATE_LANG=en_US
