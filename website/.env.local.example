# Same Supabase project the clinic app (../ at the repo root) uses — this
# site reads live data (clinic hours, team roster) from it and writes
# testimonial submissions to it.
#
# IMPORTANT — do NOT prefix these with NEXT_PUBLIC_. That project has row
# level security turned off on every table (see schema.sql in the app
# folder), so this key can read and write EVERYTHING: patient records,
# invoices, all of it. A NEXT_PUBLIC_ variable gets inlined into the
# JavaScript this site ships to every visitor's browser — anyone could
# open dev tools and pull the key straight out, then hit Supabase directly
# with it. Keeping it unprefixed means it only ever exists in server-side
# code (Route Handlers, Server Components) here on the website, the exact
# same boundary the app itself relies on.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-key

# Nomod payment links (see app/api/settle-bill) — server-side only, same
# reasoning as above.
NOMOD_API_KEY=
NOMOD_WEBHOOK_SECRET=

# The clinic staff app's own URL, once it's live on its subdomain — every
# "Book an Appointment" / "New Patient" button on this site links there
# rather than re-implementing booking. Defaults to the current Vercel
# deployment until app.epc.vet exists.
NEXT_PUBLIC_APP_URL=https://europets-r4mx3sbiv-jimbolssens-dotcom.vercel.app
